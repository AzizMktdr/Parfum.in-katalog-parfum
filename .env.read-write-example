# ============================================================
# Read/Write Database Separation — tambahkan ke .env kamu
# ============================================================

# Server WRITE (master/primary) — server utama tempat data ditulis
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_READ_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=parfuem
DB_USERNAME=root
DB_PASSWORD=

# Server READ (replica) — server replika tempat Laravel membaca data
# Jika belum punya replika (dev lokal / XAMPP), isi sama dengan DB_HOST
# supaya semua query tetap ke server yang sama


# ============================================================
# Kapan DB_READ_HOST berbeda dari DB_HOST?
# ============================================================
# Jika kamu sudah setup MySQL replication (master → slave), isi
# DB_READ_HOST dengan IP/hostname dari slave/replica server.
# Contoh:
#   DB_HOST=192.168.1.10       ← master
#   DB_READ_HOST=192.168.1.11  ← replica
# ============================================================
