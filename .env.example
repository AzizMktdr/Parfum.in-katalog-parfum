# ─────────────────────────────────────────────────────────────
# Aplikasi
# ─────────────────────────────────────────────────────────────
APP_NAME=Parfumin
APP_ENV=local
# Jalankan: php artisan key:generate
APP_KEY=
# WAJIB false di server produksi.
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# ─────────────────────────────────────────────────────────────
# Database
# Jangan pakai user root di produksi. Buat user khusus aplikasi
# dengan hak akses hanya ke database ini.
# ─────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=parfumin
DB_USERNAME=parfumin_app
DB_PASSWORD=

# Opsional: replika baca. Kosongkan kalau tidak pakai replika,
# nanti otomatis memakai DB_HOST. Lihat .env.read-write-example.
DB_READ_HOST=

# ─────────────────────────────────────────────────────────────
# Akun admin pertama (dipakai AdminSeeder)
# Kalau ADMIN_PASSWORD dikosongkan, seeder membuat password acak
# dan menampilkannya sekali di terminal.
# ─────────────────────────────────────────────────────────────
ADMIN_NAME="Admin Parfumin"
ADMIN_EMAIL=admin@parfumin.test
ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────
# Email — dibutuhkan fitur lupa password
# Development: MAIL_MAILER=log (email masuk ke storage/logs/laravel.log)
# ─────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@parfumin.test"
MAIL_FROM_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────
# Session, cache, queue
# ─────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true kalau situs sudah pakai HTTPS.
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ─────────────────────────────────────────────────────────────
# Log
# ─────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ─────────────────────────────────────────────────────────────
# Vite
# ─────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
